{
  "name": "dsh-tool-fold",
  "version": "0.2.0",
  "description": "把低频工具折叠成「名字 + 一句话」，需要时用 tool_fold 取回。按会话隔离、带真实计量、只用 deny 过滤。",
  "license": "MPL-2.0",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "LICENSE",
    "README.md",
    "CHANGELOG.md",
    "AI-DISCLOSURE.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ZJ929-max/dsh-tool-fold.git"
  },
  "homepage": "https://github.com/ZJ929-max/dsh-tool-fold#readme",
  "bugs": {
    "url": "https://github.com/ZJ929-max/dsh-tool-fold/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22"
  }
}
